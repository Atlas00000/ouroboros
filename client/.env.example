# Client environment — copy to client/.env.local (gitignored). Never commit real values.

# Absolute API URL (never relative) — local server or Railway staging/prod
NEXT_PUBLIC_API_URL=http://localhost:8000

# === AUTH (Clerk) — humans ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# === OBSERVABILITY ===
NEXT_PUBLIC_SENTRY_DSN=
