# Client environment — copy to client/.env.local (gitignored). Never commit real values.
# On Vercel: set the same keys in Project → Settings → Environment Variables
# (Production / Preview / Development as needed). See ../DEPLOYMENT.md.

# Absolute API URL (never relative) — local server or Railway public API URL
# Production example: https://ouroboros-api-production.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# === AUTH (Clerk) — humans; invite-only org (disable public sign-up in Clerk dashboard) ===
# Also add Vercel domain(s) under Clerk → Allowed origins / redirect URLs
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Server-only (RSC / route handlers) — bootstrap machine key matching
# OUROBOROS_API_KEY_CLIENT on the Railway API. NEVER prefix with NEXT_PUBLIC_
OUROBOROS_SERVER_API_KEY=

# Optional client log level (info | debug | warn | error)
NEXT_PUBLIC_LOG_LEVEL=info

# === OBSERVABILITY ===
NEXT_PUBLIC_SENTRY_DSN=
