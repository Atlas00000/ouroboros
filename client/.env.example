# Client environment — copy to client/.env.local (gitignored). Never commit real values.

# Absolute API URL (never relative) — local server or Railway staging/prod
NEXT_PUBLIC_API_URL=http://localhost:8000

# === AUTH (Clerk) — humans; invite-only org (disable public sign-up in Clerk dashboard) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Server-only local hug (RSC) — hashed machine key; NEVER prefix with NEXT_PUBLIC_
OUROBOROS_SERVER_API_KEY=

# === OBSERVABILITY ===
NEXT_PUBLIC_SENTRY_DSN=
