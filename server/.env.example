# Server environment — copy to server/.env (gitignored). Never commit real values.

# === APP ===
APP_ENV=local
APP_NAME=ouroboros-server
LOG_LEVEL=INFO

# === LOCAL INFRA (matches docker-compose defaults) ===
# Host ports match root .env (compose publishes 5433/6380 by default to avoid clashes)
DATABASE_URL=postgresql://ouroboros:ouroboros@localhost:5433/ouroboros
REDIS_URL=redis://localhost:6380/0

# === OBSERVABILITY ===
SENTRY_DSN_SERVER=

# === MT5 (Windows worker) — Phase 1 ===
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# === DATA PROVIDERS — Phase 1–3 ===
NEWS_PROVIDER=finnhub
NEWS_API_KEY=
FRED_API_KEY=

# === ALERTS ===
ALERT_CHANNEL=resend
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# === AUTH (Clerk) — humans; JWT verified on API ===
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_ALLOWED_ORG_ID=

# === EMAIL (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com
EMAIL_ALERT_TO=ops@yourdomain.com

# === LLM — Phase 3 ===
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_DAILY_BUDGET_USD=10

# === MACHINE API KEYS (bootstrap; hashes stored in DB) ===
OUROBOROS_API_KEY_CLIENT=
OUROBOROS_API_KEY_EPG=
OUROBOROS_API_KEY_QUANT=

# === CORS ===
CORS_ORIGINS=http://localhost:3000
