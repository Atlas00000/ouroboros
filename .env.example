# Root local defaults for docker-compose (non-secret defaults OK for local only).
# Real secrets go in server/.env and client/.env.local (gitignored).

POSTGRES_USER=ouroboros
POSTGRES_PASSWORD=ouroboros
POSTGRES_DB=ouroboros
# Default host ports; change if 5432/6379 are already taken locally
POSTGRES_PORT=5433
REDIS_PORT=6380
