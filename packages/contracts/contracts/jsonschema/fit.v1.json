{
  "$defs": {
    "Disclaimer": {
      "description": "Advisory disclaimer \u2014 research only, not investment advice / not execution.",
      "properties": {
        "text": {
          "default": "Ouroboros provides internal research context only. Outputs are not investment advice and do not execute trades.",
          "title": "Text",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Disclaimer",
      "type": "object"
    },
    "Provenance": {
      "description": "Trust metadata required on every Ouroboros output (roadmap F14 / N6).",
      "properties": {
        "confidence": {
          "description": "Producer confidence in [0, 1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "generated_at": {
          "description": "UTC timestamp when this output was produced.",
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "model_version": {
          "description": "Deterministic or generative model/version string, e.g. 'regimes.rule_v1'.",
          "title": "Model Version",
          "type": "string"
        },
        "sources": {
          "description": "Upstream data sources or feed IDs that contributed to this output.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stale": {
          "default": false,
          "description": "True when one or more contributing feeds exceeded cadence expectations.",
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "generated_at",
        "model_version",
        "confidence"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "description": "Regime fit for symbol \u00d7 timeframe \u00d7 edge family (schema_id: fit.v1).",
  "properties": {
    "allow_on": {
      "description": "Research gate: True only when tag == MATCH (v0).",
      "title": "Allow On",
      "type": "boolean"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "disclaimer": {
      "$ref": "#/$defs/Disclaimer"
    },
    "family": {
      "enum": [
        "meanrev",
        "trendfollow"
      ],
      "title": "Family",
      "type": "string"
    },
    "fragile_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Fragile Reasons",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "regime": {
      "anyOf": [
        {
          "description": "One of: trending_up | trending_down | ranging | high_volatility",
          "pattern": "^(trending_up|trending_down|ranging|high_volatility)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regime"
    },
    "schema_id": {
      "default": "fit.v1",
      "pattern": "^fit\\.v1$",
      "title": "Schema Id",
      "type": "string"
    },
    "shares": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional ex-post fit tag shares over window.",
      "title": "Shares"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "tag": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "FRAGILE"
      ],
      "title": "Tag",
      "type": "string"
    },
    "timeframe": {
      "description": "Bar timeframe code.",
      "pattern": "^(M1|M5|M15|M30|H1|H4|D1|W1)$",
      "title": "Timeframe",
      "type": "string"
    },
    "window": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Board window when shares present (7d|30d|calendar_month).",
      "title": "Window"
    }
  },
  "required": [
    "symbol",
    "timeframe",
    "family",
    "tag",
    "allow_on",
    "as_of",
    "provenance"
  ],
  "title": "FitSnapshot",
  "type": "object"
}
