            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled At"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "headline"
      ],
      "title": "NewsHighImpactPayload",
      "type": "object"
    },
    "Provenance": {
      "description": "Trust metadata required on every Ouroboros output (roadmap F14 / N6).",
      "properties": {
        "confidence": {
          "description": "Producer confidence in [0, 1].",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "generated_at": {
          "description": "UTC timestamp when this output was produced.",
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "model_version": {
          "description": "Deterministic or generative model/version string, e.g. 'regimes.rule_v1'.",
          "title": "Model Version",
          "type": "string"
        },
        "sources": {
          "description": "Upstream data sources or feed IDs that contributed to this output.",
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "stale": {
          "default": false,
          "description": "True when one or more contributing feeds exceeded cadence expectations.",
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "generated_at",
        "model_version",
        "confidence"
      ],
      "title": "Provenance",
      "type": "object"
